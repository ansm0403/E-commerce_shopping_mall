# Dependencies
# 루트만이 아니라 모든 하위 워크스페이스의 node_modules 제외
# (`node_modules` 한 줄은 루트만 잡아서 ops-companion 등 3GB+ 가 빌드 컨텍스트로 전송됐다)
node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist
build
.next
out

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
# (루트 패턴은 루트만 잡는다 — backend/.env 등 하위 워크스페이스의 .env 도 builder 중간 레이어에 들어가지 않게 **/ 로도 제외)
.env
**/.env
**/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode
.idea
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Database
postgres-data

# Git
.git
.gitignore

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Testing
coverage
.nyc_output

# Temporary folders
tmp/
temp/

# NX
.nx/cache

# Docs (포트폴리오, 문서 등 빌드에 불필요)
docs/

# Frontend (Vercel에서 배포, 백엔드 빌드에 불필요)
frontend/

# RN 운영 앱 (Expo 로 별도 실행, 백엔드 이미지에 불필요 — .env 까지 빌드 컨텍스트에 들어가던 것 차단)
ops-companion/
