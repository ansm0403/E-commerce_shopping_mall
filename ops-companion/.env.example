# Ops Companion 앱 환경변수 (복사해서 .env 로 쓴다)
#
# ⚠ EXPO_PUBLIC_ 접두어가 붙은 값은 빌드 시 앱 번들에 그대로 박힌다.
#    공개돼도 되는 값만 둘 것 — Sentry API 토큰 같은 비밀값은 백엔드에만 있다(설계 §7 ①).

# 백엔드 base URL. 기본값은 운영(https://api.ansmoon.dev/v1).
# 로컬 백엔드를 붙일 때는 PC 의 LAN IP 를 쓴다 — 실기기에서 localhost 는 기기 자신을 가리킨다.
# 예: EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:4000/v1
EXPO_PUBLIC_API_BASE_URL=https://api.ansmoon.dev/v1

# 이 앱 전용 Sentry 프로젝트의 DSN(쇼핑몰 프로젝트와 분리해서 새로 만들 것 — 설계 §6).
# 비어 있으면 Sentry 는 자동 비활성(no-op)이고 앱은 그대로 동작한다.
EXPO_PUBLIC_SENTRY_DSN=
