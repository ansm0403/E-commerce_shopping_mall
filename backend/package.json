{
  "name": "@shopping-mall/backend",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/jest.preset.js",
          { "externalDependencies": ["jest", "@swc/jest"] }
        ],
        "outputs": ["{projectRoot}/test-output/jest/coverage"]
      },
      "search:db:up": {
        "executor": "nx:run-commands",
        "options": { "command": "docker compose -f docker-compose.search.yaml up -d --build --wait", "cwd": "." }
      },
      "search:typecheck": {
        "dependsOn": ["^build"],
        "executor": "nx:run-commands",
        "options": { "command": "tsc --noEmit -p eval/search/tsconfig.json", "cwd": "backend" }
      },
      "search:db:verify": {
        "executor": "nx:run-commands",
        "options": { "command": "jest -c jest.integration.config.js --runInBand search-foundation.integration", "cwd": "backend" }
      },
      "search:index:verify": {
        "executor": "nx:run-commands",
        "options": { "command": "jest -c jest.integration.config.js --runInBand review-index.integration", "cwd": "backend" }
      },
      "search:query:verify": { "executor": "nx:run-commands", "options": { "command": "jest -c jest.integration.config.js --runInBand semantic-search.integration", "cwd": "backend" } },
      "search:inquiry:index:verify": { "executor": "nx:run-commands", "options": { "command": "jest -c jest.integration.config.js --runInBand inquiry-index.integration", "cwd": "backend" } },
      "search:inquiry:query:verify": { "executor": "nx:run-commands", "options": { "command": "jest -c jest.integration.config.js --runInBand inquiry-search.integration", "cwd": "backend" } },
      "search:inquiry:query:eval": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-inquiry-search-eval.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:inquiry:assistant:pilot": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-inquiry-assistant-pilot.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:inquiry:answer:eval": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-inquiry-answer-eval.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:answer:review": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-answer-review.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:worker:demo": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-worker-demo.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:inquiry:answer:audit": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-inquiry-answer-audit.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:inquiry:backfill": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/inquiry-index.cli.ts backfill", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:inquiry:reconcile": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/inquiry-index.cli.ts reconcile", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:inquiry:retry-failed": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/inquiry-index.cli.ts retry-failed", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:inquiry:cleanup": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/inquiry-index.cli.ts cleanup", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:inquiry:work": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/inquiry-index.cli.ts work", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:chat:verify": { "executor": "nx:run-commands", "options": { "command": "jest -c jest.integration.config.js --runInBand assistant-search.integration", "cwd": "backend" } },
      "search:stream:diagnose": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-stream-diagnostic.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:query:eval": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-search-eval.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/tsconfig.eval.json" } } },
      "search:answer:compare": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-answer-comparison.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:assistant:eval": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-assistant-eval.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:answer:judge": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-answer-judge.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/search/tsconfig.json" } } },
      "search:index:pilot": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register eval/search/run-index-pilot.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/tsconfig.eval.json" } } },
      "search:backfill": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/review-index.cli.ts backfill", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:reconcile": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/review-index.cli.ts reconcile", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:retry-failed": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/review-index.cli.ts retry-failed", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:work": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/review-index.cli.ts work", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:cleanup": { "executor": "nx:run-commands", "options": { "command": "node -r ts-node/register src/search/review-index.cli.ts cleanup", "cwd": "backend", "env": { "TS_NODE_PROJECT": "tsconfig.typeorm.json" } } },
      "search:pilot": {
        "executor": "nx:run-commands",
        "options": { "command": "node -r ts-node/register eval/search/run-pilot.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/tsconfig.eval.json" } }
      },
      "search:baseline": {
        "executor": "nx:run-commands",
        "options": { "command": "node -r ts-node/register eval/search/run-baseline.ts", "cwd": "backend", "env": { "TS_NODE_PROJECT": "eval/tsconfig.eval.json" } }
      },
      "migration:generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "yarn typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts src/database/migrations/{args.name}",
          "cwd": "backend",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.typeorm.json"
          }
        }
      },
      "migration:run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "yarn typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
          "cwd": "backend",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.typeorm.json"
          }
        }
      },
      "migration:revert": {
        "executor": "nx:run-commands",
        "options": {
          "command": "yarn typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
          "cwd": "backend",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.typeorm.json"
          }
        }
      },
      "migration:show": {
        "executor": "nx:run-commands",
        "options": {
          "command": "yarn typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
          "cwd": "backend",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.typeorm.json"
          }
        }
      },
      "seed": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node dist/main.js",
          "cwd": "backend",
          "env": {
            "NODE_SEED": "true",
            "SEED_DAYS": "30"
          }
        }
      },
      "seed:full": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node dist/main.js",
          "cwd": "backend",
          "env": {
            "NODE_SEED": "true",
            "SEED_PRODUCTS": "true",
            "SEED_DAYS": "30"
          }
        }
      },
      "seed:reset": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node dist/main.js",
          "cwd": "backend",
          "env": {
            "NODE_SEED": "true",
            "SEED_RESET": "true",
            "SEED_DAYS": "30"
          }
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=production"
          ],
          "cwd": "backend"
        },
        "configurations": {
          "development": {
            "args": [
              "--node-env=development"
            ]
          }
        }
      },
      "build:watch": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "--node-env=development",
            "--watch"
          ],
          "cwd": "backend"
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/backend/dist/package.json",
          "{workspaceRoot}/backend/dist/yarn.lock"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/backend/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "options": {
          "commands": [
            "nx run @shopping-mall/backend:build:development",
            "nx run @shopping-mall/backend:serve:watch"
          ],
          "cwd": "backend"
        },
        "configurations": {
          "development": {
            "commands": [
              "nx run @shopping-mall/backend:build:development",
              "nx run @shopping-mall/backend:serve:watch"
            ]
          },
          "production": {
            "commands": [
              "nx run @shopping-mall/backend:build:production",
              "nx run @shopping-mall/backend:serve:node"
            ]
          }
        }
      },
      "serve:watch": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "nx run @shopping-mall/backend:build:watch",
            "nx run @shopping-mall/backend:serve:node:watch"
          ],
          "parallel": true,
          "cwd": "backend"
        }
      },
      "serve:node:watch": {
        "executor": "nx:run-commands",
        "options": {
          "command": "wait-on dist/main.js -t 60000 && node watch-server.js",
          "cwd": "backend"
        }
      },
      "serve:node": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node dist/main.js",
          "cwd": "backend"
        }
      },
      "demo-data:check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node -r ts-node/register src/seed/repair-demo-data.ts",
          "cwd": "backend",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.typeorm.json"
          }
        }
      },
      "demo-data:repair": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node -r ts-node/register src/seed/repair-demo-data.ts --apply",
          "cwd": "backend",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.typeorm.json"
          }
        }
      },
      "demo-flow:verify": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node ../scripts/buyer-flow/verify-demo-delivery.mjs",
          "cwd": "backend"
        }
      },
      "watch-server:verify": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node ../scripts/buyer-flow/verify-watch-server.mjs",
          "cwd": "backend"
        }
      },
      "demo:prepare": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node -r ts-node/register src/seed/prepare-role-demo.cli.ts",
          "cwd": "backend",
          "env": {
            "TS_NODE_PROJECT": "tsconfig.typeorm.json"
          }
        }
      },
      "typecheck": {
        "dependsOn": ["^build"],
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit -p tsconfig.app.json",
          "cwd": "backend"
        }
      },
      "role-demo:verify": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node ../scripts/buyer-flow/verify-role-demos.mjs",
          "cwd": "backend"
        }
      }
    }
  },
  "dependencies": {
    "@google/genai": "*",
    "@nestjs/axios": "*",
    "@nestjs/common": "*",
    "@nestjs/config": "*",
    "@nestjs/core": "*",
    "@nestjs/event-emitter": "*",
    "@nestjs/jwt": "*",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "*",
    "@nestjs/platform-express": "*",
    "@nestjs/schedule": "*",
    "@nestjs/throttler": "*",
    "@nestjs/typeorm": "*",
    "@sentry/nestjs": "*",
    "@shopping-mall/shared": "*",
    "class-transformer": "*",
    "class-validator": "*",
    "pg": "*",
    "reflect-metadata": "*",
    "rxjs": "*",
    "typeorm": "*"
  },
  "devDependencies": {
    "@types/pg": "*"
  }
}
