# 서버 설정
PROTOCOL=http
HOST=localhost:4000
PORT=4000

# PostgreSQL 설정
# EC2 배포 시 POSTGRES_HOST/PORT는 docker-compose가 오버라이드함 (값: postgres, 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your-username
POSTGRES_PASSWORD=your-password
POSTGRES_DB=your-database

# Redis 설정
# EC2 배포 시 REDIS_HOST/PORT는 docker-compose가 오버라이드함 (값: redis, 6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 설정
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here

# 이메일 설정 (Gmail 또는 Naver 중 선택)

# === Gmail 사용하는 경우 ===
# 1. Google 계정에서 2단계 인증 활성화
# 2. 앱 비밀번호 생성 (https://myaccount.google.com/apppasswords)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# === Naver 메일 사용하는 경우 ===
MAIL_HOST=smtp.naver.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-naver-id
MAIL_PASSWORD=your-naver-password

# 공통 설정
MAIL_FROM_NAME=Shopping Mall
MAIL_FROM_ADDRESS=your-email@naver.com

# 프론트엔드 URL (이메일 인증 링크 생성에 사용됨 — 필수, fallback 없음)
# 로컬: http://localhost:3000
# 운영(EC2): Vercel production alias (ex: https://your-app.vercel.app)
# ※ preview/hash URL(ex: -gne675cog-.vercel.app) 사용 금지 — 배포마다 바뀜
FRONTEND_URL=http://localhost:3000

# CORS 허용 origin 목록 (콤마 구분, FRONTEND_URL과 별도 관리)
# FRONTEND_URL은 이메일 링크용, CORS_ORIGINS는 브라우저 요청 허용용으로 역할 분리
# 로컬: http://localhost:3000
# 운영(EC2): https://your-app.vercel.app
# 운영은 Vercel 프록시 방식이라 실질적으로 CORS가 발생하지 않지만 명시 권장
CORS_ORIGINS=http://localhost:3000

# 데모 관리자 계정 (포트폴리오 시연용)
# 시드 배치(NODE_SEED=true)가 이 값으로 관리자 계정을 생성한다.
# ⚠ 미설정 시 에러 없이 데모 관리자만 조용히 빠지고, 관리자행위 감사로그 actor 가
#   전부 null 로 떨어진다(조용한 실패). 시드를 쓸 거면 반드시 설정할 것.
# DEMO_LOGIN_ENABLED: 로그인 화면의 "데모 계정으로 로그인" 버튼 활성화 여부.
DEMO_ADMIN_EMAIL=demo-admin@your-domain.local
DEMO_ADMIN_PASSWORD=change-me
DEMO_LOGIN_ENABLED=true

# 포트원 V2
# 포트원 콘솔(https://admin.portone.io) → 결제 연동 → API & SDK → V2 API Secret
PORTONE_API_SECRET=your-portone-v2-api-secret

# Sentry (백엔드 에러 추적)
# Sentry 프로젝트(shopping-mall-backend) → Settings → Client Keys(DSN)
# 비어 있으면 Sentry는 자동 비활성화됨. 운영(EC2)에선 docker-compose/배포 환경변수로 주입.
SENTRY_DSN=

# AI 어시스턴트 (관리자) — LLM 연동
# LLM_PROVIDER: 사용할 프로바이더. 현재 'gemini'(무료티어), 추후 'claude' 전환 예정.
# GEMINI_API_KEY: Google AI Studio(https://aistudio.google.com/apikey)에서 발급.
#   비어 있으면 AI 어시스턴트는 자동 비활성화(no-op)됨.
# GEMINI_MODEL: 사용할 모델 ID. free-tier 가용 모델/한도를 AI Studio에서 확인 후 지정.
#   기본 gemini-3.1-flash-lite — 비-thinking이라 스트리밍이 잘게 흐르고 무료 RPD가 넉넉.
#   ※ gemini-3.5-flash는 thinking 모델이라 (1) 답을 큰 덩어리로 내보내 스트리밍 체감이 약하고
#      (2) 무료 RPD가 매우 작다(관측 ~20/day). 정교한 분석이 필요할 때만 한시적으로 사용.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Ops Companion(RN 운영 앱) — Sentry Web API 조회용 (docs/roadmap/ops-companion-design.md §5.1·§11-1)
# SENTRY_AUTH_TOKEN: Sentry → Settings → Auth Tokens 에서 발급. 필요 권한 org:read · project:read · event:read
#   SENTRY_DSN(에러 "전송")과 별개의 비밀값이다. 둘 중 하나라도 비어 있으면 /v1/ops/incidents 는 503(비활성)
#   — 서버 기동에는 영향 없음. 앱 코드/EAS secrets 에 절대 넣지 않는다(백엔드 환경변수에만).
# SENTRY_ORG_SLUG: Sentry 조직 슬러그 (sentry.io/organizations/<slug>/ 의 <slug>)
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
# Ops Companion 푸시 발송 (Phase 1 — 설계 §9 Phase 1 "확정한 푸시 기준")
# 폴링 스케줄러가 2분마다 Sentry 를 보고, error·fatal 인 새 이슈(또는 쿨다운이 지난 재발)를
# 등록된 기기로 보낸다. SENTRY_AUTH_TOKEN 이 없으면 아무 일도 하지 않으므로 로컬에서는 신경 쓸 필요 없다.
# OPS_PUSH_ENABLED: 기본 true. 발송만 끄고 싶을 때 false (조회 API 는 계속 동작)
# OPS_PUSH_PROJECTS: 알림 대상 Sentry 프로젝트 slug(쉼표). 앱 자신(ops-companion)은 넣지 않는다
#   — 앱이 죽어 푸시가 오고 그 푸시로 앱을 열어 또 죽는 되먹임을 막는다.
# OPS_PUSH_COOLDOWN_HOURS: 같은 이슈를 다시 알리기까지의 최소 간격(기본 6). 데모 재촬영 때만 줄인다.
# EXPO_ACCESS_TOKEN: Expo 프로젝트에 푸시 보안(Enhanced Security)을 켰을 때만 필요. 지금은 비워 둔다.
OPS_PUSH_ENABLED=true
OPS_PUSH_PROJECTS=e-commerse-frontend,e-commerse-backend
OPS_PUSH_COOLDOWN_HOURS=6
EXPO_ACCESS_TOKEN=

