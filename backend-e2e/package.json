{
  "name": "@shopping-mall/backend-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@shopping-mall/backend"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "backend-e2e/jest.config.cjs",
          "passWithNoTests": true
        }
      }
    }
  }
}
