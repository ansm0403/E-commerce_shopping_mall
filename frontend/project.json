{
  "name": "@shopping-mall/frontend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "frontend"
      }
    },
    "demo-checkout:verify": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../scripts/buyer-flow/verify-demo-checkout.mjs",
        "cwd": "frontend"
      }
    },
    "auth:verify": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../scripts/buyer-flow/verify-auth-navigation.mjs",
        "cwd": "frontend"
      }
    },
    "build": {
      "inputs": [
        "production",
        "^production",
        { "env": "API_PROXY_TARGET" },
        { "env": "NEXT_PUBLIC_API_URL" },
        { "env": "NEXT_PUBLIC_PORTONE_STORE_ID" },
        { "env": "NEXT_PUBLIC_PORTONE_CHANNEL_KEY" },
        { "env": "ANALYZE" },
        { "env": "NEXT_PUBLIC_SENTRY_DSN" },
        { "env": "SENTRY_DSN" },
        { "env": "SENTRY_AUTH_TOKEN" },
        { "env": "SENTRY_ORG" },
        { "env": "SENTRY_PROJECT" }
      ],
      "options": {
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=4096"
        }
      }
    }
  }
}
