# Next.js 프론트 환경변수 (복사해서 .env 로 쓴다)
#
# NEXT_PUBLIC_ 접두어가 붙은 값은 브라우저 번들에 그대로 들어간다 — 공개돼도 되는 값만.

PORT=3000

# 백엔드 API base. 로컬은 백엔드 직통(CORS 는 backend/.env 의 CORS_ORIGINS 로 허용).
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# PortOne V2 (결제 화면). 포트원 콘솔 → 결제 연동 → 채널 관리
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# Sentry 프론트 프로젝트 DSN. 비어 있으면 Sentry 는 자동 no-op.
NEXT_PUBLIC_SENTRY_DSN=

# --- 아래는 서버(Vercel) 쪽에서만 읽는 값. 로컬 .env 에는 보통 두지 않는다 ---
# API_PROXY_TARGET   : next.config.js rewrites 의 목적지. 운영은 https://api.ansmoon.dev/v1, 미설정이면 http://localhost:4000/v1
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN : 빌드 시 소스맵 업로드용(운영 Vercel 환경변수). 없으면 업로드만 건너뛴다.
